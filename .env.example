# Copy to .env. Every variable is required and validated at startup (apps/api/src/config/env.schema.ts).

NODE_ENV=development
PORT=3001

# Postgres + pgvector (docker-compose.yml). Host port 5435 avoids a local Postgres on 5432.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_local_only
POSTGRES_DB=rag
POSTGRES_HOST_PORT=5435
DATABASE_URL=postgres://rag:rag_local_only@localhost:5435/rag
# Used only by the contract tests. Tables are truncated on every run.
TEST_DATABASE_URL=postgres://rag:rag_local_only@localhost:5435/rag_test

# Supplied pack (read-only) and our reviewed authority layer. Paths relative to the repo root.
PACK_DIR=Kentrick_Assessment_Pack_Candidate
AUTHORITY_FILE=data/authority.yaml

# Embeddings: in-process, CPU. First run downloads ~440 MB (fp32) into EMBEDDING_CACHE_DIR.
# transformers (in-process ONNX) or fake (tests). Changing provider, model or dim needs ingest --reindex.
EMBEDDING_PROVIDER=transformers
# Models using CLS pooling + the "Represent this sentence for searching relevant passages: " query
# instruction (bge-v1.5, snowflake-arctic-embed v1.5). EMBEDDING_DIM must match chunks.embedding in migrations/.
EMBEDDING_MODEL_ID=Snowflake/snowflake-arctic-embed-m-v1.5
EMBEDDING_DIM=768
EMBEDDING_DTYPE=fp32
EMBEDDING_CACHE_DIR=.cache/models
# Set to false after the first download for fully offline runs.
EMBEDDING_ALLOW_REMOTE=true

# Optional cross-encoder reranker (search --rerank, ask --rerank). Loaded on first use, ~280 MB at q8.
# transformers (in-process ONNX) or fake (tests).
RERANKER_PROVIDER=transformers
RERANKER_MODEL_ID=Xenova/bge-reranker-base
RERANKER_DTYPE=q8

# Soft-deleted documents older than this are hard-purged by purgeDeleted.
PURGE_RETENTION_DAYS=30

# LLM for answer generation. OpenAI-compatible endpoint (Ollama, llama.cpp, vLLM, Azure OpenAI) or "fake" for tests.
LLM_PROVIDER=openai-compat
LLM_BASE_URL=http://localhost:11434
# Default: qwen3.5 0.8B (MLX, 1.2 GB), plain-text answers. With an 8k context:
#   ollama pull qwen3.5:0.8b-mlx
#   printf 'FROM qwen3.5:0.8b-mlx\nPARAMETER num_ctx 8192\n' > Modelfile && ollama create qwen3.5-0.8b-8k -f Modelfile
LLM_MODEL_ID=qwen3.5-0.8b-8k
# Leave empty for local Ollama. Set for hosted providers.
LLM_API_KEY=
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=1500
# true turns thinking off: sends reasoning_effort "none" + /no_think and strips <think> blocks.
# Thinking-only models (e.g. Qwen3-4B-Thinking-2507, "qwen3:4b" today) ignore it: use qwen3.5:4b instead.
LLM_DISABLE_THINKING=true
